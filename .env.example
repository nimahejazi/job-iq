# Public Supabase project URL. This is safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key used by browser/client Supabase calls. Row Level Security must protect data access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key for trusted backend tasks. Never expose this through client components or browser bundles.
SUPABASE_SECRET_KEY=

# Optional OpenAI API key for AI-based resume profile extraction in the backend worker.
OPENAI_API_KEY=

# Optional model override for resume profile extraction. Defaults to gpt-4o-mini.
OPENAI_RESUME_MODEL=

# Optional embedding model override for resume/profile vectors. Defaults to text-embedding-3-small.
OPENAI_EMBEDDING_MODEL=

# Optional embedding size override for text-embedding-3 models. Defaults to 1536.
OPENAI_EMBEDDING_DIMENSIONS=

# USAJOBS API credentials for the backend sync script.
# The user agent should be a contact email address or app identifier that USAJOBS can identify.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Optional USAJOBS sync defaults for the local backend script.
USAJOBS_KEYWORD=
USAJOBS_LOCATION=
USAJOBS_DATE_POSTED_DAYS=14
USAJOBS_RESULTS_PER_PAGE=50
USAJOBS_MAX_PAGES=2

# Optional Remotive sync defaults for the local backend script.
REMOTIVE_SEARCH=
REMOTIVE_CATEGORY=
REMOTIVE_COMPANY_NAME=
REMOTIVE_LIMIT=0
