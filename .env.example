# Public Supabase project URL. This is safe to expose to browser code.
NEXT_PUBLIC_SUPABASE_URL=

# Public publishable key used by browser/client Supabase calls. Row Level Security must protect data access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key for trusted backend tasks. Never expose this through client components or browser bundles.
SUPABASE_SECRET_KEY=
